# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NOIZ_AI_API_KEY: API Key for Noiz.ai Text-to-Speech (TTS) Voice Synthesis
NOIZ_AI_API_KEY=

# NOIZ AI 6 Character Voice IDs (Optional custom voice mapping)
NOIZ_VOICE_RINA=
NOIZ_VOICE_NOVA=
NOIZ_VOICE_BAYU=
NOIZ_VOICE_MAYA=
NOIZ_VOICE_ARGA=
NOIZ_VOICE_ALISA=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL & SUPABASE_ANON_KEY: Supabase PostgreSQL Database & Backend
# Dapatkan URL dan anon/public key dari Dashboard Supabase -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

